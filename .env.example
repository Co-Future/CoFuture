# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local wird nie committet.

# Supabase (Region Frankfurt)
# Project Settings → API: Project URL und publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): nur serverseitig, nur in .env.local und Vercel.
# Nötig für Jobs, Worker, Personen anlegen und Zugangslinks.
SUPABASE_SECRET_KEY=

# Speech-to-Text: Whisper large-v3-turbo über Groq, Reserve Gemini (ADR 004)
GROQ_API_KEY=

# Sprachmodell: Gemini, Reserve Groq (ADR 005). "groq" stellt Groq zuerst (Tests, Quote sparen)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Worker: Geheimnis, mit dem pg_cron die Worker-Route aufruft (ADR 009)
WORKER_SECRET=

# E-Mail (später, für Magic Link und Benachrichtigungen)
RESEND_API_KEY=
