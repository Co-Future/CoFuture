# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local wird nie committet.

# Supabase (Region Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Speech-to-Text (Whisper)
OPENAI_API_KEY=

# Sprachmodell (Entscheidung im PoC: anthropic oder openai)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# E-Mail
RESEND_API_KEY=
