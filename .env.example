# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# .env.local wird nie committet.

# Supabase (Region Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Speech-to-Text: Whisper large-v3 über Groq (ADR 004)
STT_PROVIDER=groq
GROQ_API_KEY=

# Sprachmodell: Mistral, Reserve anthropic oder openai (ADR 005)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Worker: Geheimnis, mit dem pg_cron die Worker-Route aufruft (ADR 009)
WORKER_SECRET=

# E-Mail (später, für Magic Link und Benachrichtigungen)
RESEND_API_KEY=
